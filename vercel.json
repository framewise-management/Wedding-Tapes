{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "Dockerfile.vercel"
    },
    "hono-spike": {
      "root": "hono-spike",
      "entrypoint": "index.ts"
    }
  },
  "rewrites": [
    { "source": "/api(/.*)?", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/spike-health", "destination": { "service": "hono-spike" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
