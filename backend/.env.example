PORT=3333

DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

FRONTEND_URL=http://localhost:5173

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# Optional: Discord webhook URL for signup/proposal/share-link event logging.
# Leave unset to disable — notifications are a silent no-op without it.
DISCORD_WEBHOOK_URL=

# Google Calendar direct sync (optional) — service-account key JSON, single line.
# Leave unset to disable direct Google Calendar sync.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apple Calendar CalDAV sync (optional) - AES-256-GCM key protecting the stored
# app-specific password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=
